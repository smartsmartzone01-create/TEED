# =====================================================
# TEED Environment Configuration
#
# Copy this file to .env and fill in the required values.
# Never commit your .env file.
# =====================================================


# =====================================================
# DJANGO
# =====================================================
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

LOGIN_IP_THROTTLE_RATE=10/minute
LOGIN_EMAIL_THROTTLE_RATE=5/minute
THROTTLE_NUM_PROXIES=0
REFRESH_TOKEN_COOKIE_NAME=teed_refresh
EMAIL_VERIFICATION_MAX_ATTEMPTS=3
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_DAILY_LIMIT=5
EMAIL_VERIFICATION_RESEND_IP_THROTTLE_RATE=20/hour
EMAIL_VERIFICATION_RESEND_ACCOUNT_THROTTLE_RATE=5/hour
EMAIL_REGISTRATION_IP_THROTTLE_RATE=10/hour
PASSWORD_RESET_IP_THROTTLE_RATE=10/hour
PASSWORD_RESET_ACCOUNT_THROTTLE_RATE=5/hour
PASSWORD_RESET_GRANT_TTL_MINUTES=10
PASSWORD_RESET_REQUESTS_PER_HOUR=3
IDENTITY_SECURITY_EVENT_RETENTION_DAYS=180
DEVICE_COOKIE_NAME=teed_device
DEVICE_COOKIE_MAX_AGE_SECONDS=31536000
PASSWORD_RESET_COOKIE_NAME=teed_password_reset
EMAIL_DELIVERY_PROVIDER=apps.identity.email.DjangoEmailProvider
EMAIL_DELIVERY_ENCRYPTION_KEY=
EMAIL_DELIVERY_MAX_ATTEMPTS=5
EMAIL_DELIVERY_RETRY_BASE_SECONDS=60
EMAIL_DELIVERY_RETRY_MAX_SECONDS=3600
EMAIL_DELIVERY_LOCK_TIMEOUT_SECONDS=300
EMAIL_DELIVERY_TTL_HOURS=24
EMAIL_DELIVERY_RETENTION_DAYS=30

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
TRUST_X_FORWARDED_PROTO=False

# =====================================================
# DATABASE
# =====================================================
DB_NAME=teed_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# =====================================================
# EMAIL
# =====================================================
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# =====================================================
# REDIS
# =====================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/1

# =====================================================
# CELERY
# =====================================================
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# =====================================================
# STORAGE
# =====================================================
MEDIA_URL=/media/
STATIC_URL=/static/

# =====================================================
# AI
# =====================================================
OPENAI_API_KEY=
GEMINI_API_KEY=

# =====================================================
# PAYMENTS
# =====================================================
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# =====================================================
# SOCIAL LOGIN
# =====================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=


# =====================================================
# FRONTEND
# =====================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
TEED_ALLOWED_DEV_ORIGINS=
